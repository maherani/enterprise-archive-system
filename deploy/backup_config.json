{
    "backup_enabled": true,
    "backup_type": "full_instance",
    "storage_location": "/home/alborz/enterprise-archive-system/deploy/backups",
    "schedule": {
        "enabled": true,
        "cron_expression": "0 2 * * *",
        "description": "Daily full instance disaster recovery backup at 02:00 AM"
    },
    "retention_policy": {
        "max_backups_count": 14,
        "retention_days": 30,
        "auto_prune": true
    },
    "notifications": {
        "on_failure": true,
        "on_success": false
    },
    "system_backup": {
        "enabled": true,
        "cron_expression": "0 1 * * *",
        "description": "System Software & Configuration Backup before baseline changes",
        "max_backups_count": 14,
        "retention_days": 30
    },
    "instance_data_backup": {
        "enabled": true,
        "cron_expression": "0 3 * * *",
        "description": "Operational Database & User Data Backup",
        "max_backups_count": 14,
        "retention_days": 30
    }
}