# ==============================================================================
# Enterprise Archive System - Environment Configuration Template
# Copy this file to .env and configure strong, unique passwords for production:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud_user
POSTGRES_PASSWORD=ChangeMe_StrongPostgresPassword_123!

# Nextcloud Primary Administrator Credentials
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=ChangeMe_StrongAdminPassword_123!

# Nextcloud Trusted Domains (Space-separated list of hostnames/IPs)
NEXTCLOUD_TRUSTED_DOMAINS="localhost 127.0.0.1 docs.maskan"

# ==============================================================================
# AI Box Integration & Vector Engine Settings
# ==============================================================================
VECTOR_DB=lancedb
EMBEDDING_MODEL_PREF=qwen2.5:0.5b-instruct
SESSION_ACL_CACHE_TTL=3600
